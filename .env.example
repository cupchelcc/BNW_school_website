# Environment Mode
NODE_ENV=development

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database Configuration (LibSQL / SQLite / Cloudflare D1)
# For local development: file:bnw_school.db
# For production Cloudflare D1 / Turso: libsql://... or D1 binding
DATABASE_URL=file:bnw_school.db
DATABASE_AUTH_TOKEN=

# Authentication Secret (JWT & Session Encryption - Minimum 32 characters)
AUTH_SECRET=sample-secret-key-at-least-32-characters-long-bnw-v2

# Initial Admin Bootstrap Credentials (Used only on initial setup)
ADMIN_BOOTSTRAP_NAME="ผู้ดูแลระบบหลัก"
ADMIN_BOOTSTRAP_EMAIL=admin@bnw.ac.th
ADMIN_BOOTSTRAP_PASSWORD=BnwAdmin2026!ChangeMe

# Cloudflare R2 Storage (Optional for production cloud storage; uses local storage in development)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bnw-media
R2_PUBLIC_URL=
